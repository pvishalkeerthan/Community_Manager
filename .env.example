# -----------------------------------------------------------------------------
# Community Manager - Environment Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to a new file named '.env'
# 2. Update the values below with your specific environment settings.
# 3. DO NOT commit your actual '.env' file to version control.
# -----------------------------------------------------------------------------

# [DATABASE]
# MongoDB Connection String (Local or Atlas)
MONGO_URL=mongodb://localhost:27017/community_manager

# [SERVER]
# Port number for the express server
PORT=3000

# [SECURITY]
# Secret for express-session (CRITICAL: Change this to a long random string in production!)
SESSION_SECRET=your_super_secret_session_key_here
